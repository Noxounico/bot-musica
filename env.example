# Discord
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_client_id

# Optional: used to clear leftover slash commands on one guild
DISCORD_GUILD_ID=

# Spotify (create app at https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# Run `npm run auth:spotify` once to obtain this, or open /spotify on Railway
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token

# Railway: https://YOUR-SERVICE.up.railway.app/callback (must match Spotify Dashboard)
SPOTIFY_REDIRECT_URI=

# How often to poll Spotify playback state (milliseconds)
SPOTIFY_POLL_MS=2000
