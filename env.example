# Discord
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_client_id

# Optional: used to register commands on one guild during tests
DISCORD_GUILD_ID=

# Optional Spotify Search (client_credentials only — no login, no Premium)
# Used for artwork and title. The bot plays via YouTube either way.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
